ENVIRONMENT=production
PROJECT_NAME="AI Accounting Software"
API_V1_STR=/api/v1
JWT_SECRET_KEY=prod_super_secure_key_from_aws_kms_or_secrets_manager
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
POSTGRES_SERVER=prod-db.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=prod_secure_password
POSTGRES_DB=ai_accounting_prod
DATABASE_URL=postgresql+asyncpg://prod_user:prod_secure_password@prod-db.ap-south-1.rds.amazonaws.com:5432/ai_accounting_prod
DATABASE_SYNC_URL=postgresql://prod_user:prod_secure_password@prod-db.ap-south-1.rds.amazonaws.com:5432/ai_accounting_prod
REDIS_URL=redis://prod-redis.ap-south-1.cache.amazonaws.com:6379/0
SENTRY_DSN=https://sample-sentry-dsn@o123456.ingest.sentry.io/prod
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
LOG_LEVEL=WARNING
AI_SERVICE_URL=https://ai.internal:8001
