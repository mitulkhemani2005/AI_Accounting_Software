# ==============================================================================
# AI Accounting Software - Root Environment Configuration Template
# Target Region: India (AWS ap-south-1 / GCP asia-south1 Mumbai)
# ==============================================================================

# Environment: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="AI Accounting Software"
API_V1_STR=/api/v1

# Multi-Tenant & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_string_for_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL in Mumbai Region for Data Localization)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_accounting_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_accounting_dev
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_accounting_dev

# Redis / Job Queue
REDIS_URL=redis://localhost:6379/0

# Observability & Logging
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
LOG_LEVEL=INFO

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8001

# Razorpay India Payment Gateway (Phase 6)
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=sample_secret

# WhatsApp Business API (Phase 2 & 5)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
