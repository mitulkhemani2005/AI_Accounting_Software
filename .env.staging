ENVIRONMENT=staging
PROJECT_NAME="AI Accounting Software [STAGING]"
API_V1_STR=/api/v1
JWT_SECRET_KEY=staging_secret_key_to_be_provided_by_secret_manager_mumbai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
POSTGRES_SERVER=staging-db.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_secure_password
POSTGRES_DB=ai_accounting_staging
DATABASE_URL=postgresql+asyncpg://staging_user:staging_secure_password@staging-db.ap-south-1.rds.amazonaws.com:5432/ai_accounting_staging
DATABASE_SYNC_URL=postgresql://staging_user:staging_secure_password@staging-db.ap-south-1.rds.amazonaws.com:5432/ai_accounting_staging
REDIS_URL=redis://staging-redis.ap-south-1.cache.amazonaws.com:6379/0
SENTRY_DSN=https://sample-sentry-dsn@o123456.ingest.sentry.io/staging
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5
LOG_LEVEL=INFO
AI_SERVICE_URL=https://staging-ai.internal:8001
