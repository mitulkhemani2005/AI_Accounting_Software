ENVIRONMENT=development
PROJECT_NAME="AI Accounting Software [DEV]"
API_V1_STR=/api/v1
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
